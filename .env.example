# --- Database ---
DATABASE_URL="postgresql://localhost:5432/vv_collectibles"

# --- Auth (NextAuth v4) ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# --- Public site URL (used for invoices, payment redirects, webhooks) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Rabo OnlineKassa (payments) ---
# Leave RABO_REFRESH_TOKEN or RABO_SIGNING_KEY empty to run checkout in STUB
# mode (no real payment, orders auto-marked paid).
#
# Both values come from the Rabo Smart Pay dashboard. The signing key is
# base64 and is decoded before use — paste it exactly as shown, do not decode
# it yourself. Treat both as secrets: never commit them.
RABO_REFRESH_TOKEN=""
RABO_SIGNING_KEY=""
# "sandbox" (default) or "production"
RABO_ENVIRONMENT="sandbox"
# Register this URL as the webhook in the Rabo dashboard:
#   ${NEXT_PUBLIC_SITE_URL}/api/webhooks/rabo

# --- PostNL (shipping labels) ---
# Leave empty to run label generation in STUB mode (fake barcode + label).
POSTNL_API_KEY=""
POSTNL_CUSTOMER_CODE=""
POSTNL_CUSTOMER_NUMBER=""
POSTNL_COLLECTION_LOCATION=""
# Sender address printed on labels
SHIP_FROM_NAME="V&V Collectibles"
SHIP_FROM_STREET="Voorbeeldstraat"
SHIP_FROM_HOUSENR="1"
SHIP_FROM_ZIP="1234AB"
SHIP_FROM_CITY="Amsterdam"
SHIP_FROM_COUNTRY="NL"

# --- Email (Resend) ---
# Leave empty to log emails to console instead of sending.
RESEND_API_KEY=""
EMAIL_FROM="V&V Collectibles <orders@vvcollectibles.nl>"
