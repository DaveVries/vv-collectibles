# --- Database ---
DATABASE_URL="postgresql://localhost:5432/vv_collectibles"

# --- Auth (NextAuth v4) ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# --- Public site URL (used for invoices, payment redirects, webhooks) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Mollie (payments) ---
# Leave empty to run checkout in STUB mode (no real payment, orders auto-marked paid).
# Get keys at https://my.mollie.com/dashboard/developers/api-keys
MOLLIE_API_KEY=""

# --- PostNL (shipping labels) ---
# Leave empty to run label generation in STUB mode (fake barcode + label).
POSTNL_API_KEY=""
POSTNL_CUSTOMER_CODE=""
POSTNL_CUSTOMER_NUMBER=""
POSTNL_COLLECTION_LOCATION=""
# Sender address printed on labels
SHIP_FROM_NAME="V&V Collectibles"
SHIP_FROM_STREET="Voorbeeldstraat"
SHIP_FROM_HOUSENR="1"
SHIP_FROM_ZIP="1234AB"
SHIP_FROM_CITY="Amsterdam"
SHIP_FROM_COUNTRY="NL"

# --- Email (Resend) ---
# Leave empty to log emails to console instead of sending.
RESEND_API_KEY=""
EMAIL_FROM="V&V Collectibles <orders@vvcollectibles.nl>"
